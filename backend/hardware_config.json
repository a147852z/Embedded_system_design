{
  "version": 1,
  "gpio": {
    "numbering": "BCM",
    "active_high": true
  },
  "shared": {
    "buzzer": {
      "pin": 18
    }
  },
  "spots": {
    "1": {
      "label": "A-1",
      "led": { "r": 5, "y": 6, "g": 13 },
      "ultrasonic": {
        "left": { "trigger": 23, "echo": 24 },
        "right": { "trigger": 27, "echo": 22 }
      }
    },
    "2": {
      "label": "A-2",
      "led": { "r": 16, "y": 20, "g": 21 },
      "ultrasonic": {
        "left": { "trigger": 17, "echo": 4 },
        "right": { "trigger": 19, "echo": 26 }
      }
    }
  },
  "cameras": {
    "entrance": {
      "device": {
        "windows": 0,
        "linux": "/dev/video0",
        "default": 0
      },
      "resolution": { "width": 1280, "height": 720 },
      "roi_by_spot": {}
    },
    "parking": {
      "device": {
        "windows": 1,
        "linux": "/dev/video1",
        "default": 1
      },
      "resolution": { "width": 1280, "height": 720 },
      "roi_by_spot": {
        "1": { "x": 0, "y": 0, "w": 640, "h": 360 },
        "2": { "x": 640, "y": 0, "w": 640, "h": 360 },
        "3": { "x": 0, "y": 360, "w": 640, "h": 360 },
        "4": { "x": 640, "y": 360, "w": 640, "h": 360 }
      }
    }
  },
  "logic": {
    "poll_dt_seconds": 0.1,
    "stabilize": {
      "median_samples": 5,
      "median_sample_dt_seconds": 0.02
    },
    "thresholds": {
      "misalign_max_cm": 3.0,
      "approach_any_lt_m": 0.03,
      "leave_any_gt_m": 0.05,
      "parked_stable_seconds": 2.0
    }
  }
}

